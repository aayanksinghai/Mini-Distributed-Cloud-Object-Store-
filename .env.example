# Copy to `.env` and adjust. docker-compose reads `.env` automatically.
# All values have safe local defaults in docker-compose.yml, so this file is optional for local runs.

# --- PostgreSQL (controller metadata store) ---
POSTGRES_DB=objectstore
POSTGRES_USER=objectstore
POSTGRES_PASSWORD=objectstore

# --- Shared secret for internal controller <-> worker API (change for anything non-local) ---
INTERNAL_API_TOKEN=change-me-internal-token

# --- Host ports for the controller REST API and web dashboard ---
CONTROLLER_PORT=8080
DASHBOARD_PORT=3000

# --- Limits & timing ---
MAX_OBJECT_SIZE=1GB
HEARTBEAT_INTERVAL_MS=3000
HEARTBEAT_TIMEOUT_MS=10000
HEARTBEAT_CHECK_INTERVAL_MS=2000
REREPLICATION_GRACE_PERIOD_MS=30000
REPAIR_INTERVAL_MS=10000
WORKER_REQUEST_TIMEOUT_MS=5000
SCRUB_INTERVAL_MS=300000

# --- Demo helpers ---
WORKER_DEBUG_ENDPOINTS=false

LOG_LEVEL=INFO

